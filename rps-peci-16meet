<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RPS Interaktif - Pengolahan Citra Digital (PBL)</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        .chart-container {
            position: relative;
            width: 100%;
            max-width: 500px;
            margin-left: auto;
            margin-right: auto;
            height: 250px;
            max-height: 280px;
        }
        .tab-btn.active {
            border-bottom-color: #4f46e5;
            color: #4f46e5;
            font-weight: 700;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans min-h-screen flex flex-col justify-between antialiased">

<!-- Chosen Palette: Clean Light Slate & Indigo Academic Palette -->
<!-- Application Structure Plan: Single-page interactive RPS (Rencana Pembelajaran Semester) application for Pengolahan Citra Digital (PCD). Features responsive navigation, complete course metadata, detailed weekly breakdown (P1-P16) with interactive filters (Phase, CPMK, Topic Search), Project-Based Learning (PBL) Alignment Map, Chart.js Grading Breakdown & Weekly Workload, interactive Grade Simulator, and RPS Export Tool. Designed with a light background for clear reading and academic presentation. -->
<!-- Visualization & Content Choices: Chart.js Donut chart for Assessment Breakdown; Chart.js Bar chart for Weekly Workload distribution; Custom HTML/Tailwind cards for weekly syllabus items; Dynamic JS filtering & search. Confirming NO SVG and NO Mermaid JS used. -->
<!-- CONFIRMATION: NO SVG graphics used. NO Mermaid JS used. -->

<!-- Header & Navigation -->
<header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-indigo-600 flex items-center justify-center text-white font-extrabold text-lg shadow-md shadow-indigo-200">
                    PCD
                </div>
                <div>
                    <h1 class="text-base font-bold text-slate-900 leading-tight">Rencana Pembelajaran Semester (RPS)</h1>
                    <p class="text-xs text-indigo-600 font-semibold">Pengolahan Citra Digital • 3 SKS (1 Teori, 2 Praktikum)</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <button onclick="openExportModal()" class="px-3.5 py-2 rounded-lg bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-xs font-semibold border border-indigo-200 transition flex items-center gap-2">
                    <i class="fa-solid fa-file-export"></i>
                    <span class="hidden sm:inline">Ekspor Teks RPS</span>
                </button>
                <button onclick="scrollToSection('kalkulator')" class="px-3.5 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold transition flex items-center gap-2 shadow-sm">
                    <i class="fa-solid fa-calculator"></i>
                    <span class="hidden sm:inline">Simulasi Nilai</span>
                </button>
            </div>
        </div>
        <!-- Navigation Tabs -->
        <div class="flex space-x-6 border-t border-slate-100 text-xs font-medium text-slate-500 overflow-x-auto no-scrollbar">
            <button onclick="switchTab('ringkasan')" id="tab-ringkasan" class="tab-btn active py-3 border-b-2 border-transparent hover:text-indigo-600 whitespace-nowrap">
                <i class="fa-solid fa-circle-info mr-1.5"></i> Ringkasan & CPMK
            </button>
            <button onclick="switchTab('matriks')" id="tab-matriks" class="tab-btn py-3 border-b-2 border-transparent hover:text-indigo-600 whitespace-nowrap">
                <i class="fa-solid fa-calendar-days mr-1.5"></i> Matriks Pertemuan (P1 - P16)
            </button>
            <button onclick="switchTab('pbl-map')" id="tab-pbl-map" class="tab-btn py-3 border-b-2 border-transparent hover:text-indigo-600 whitespace-nowrap">
                <i class="fa-solid fa-diagram-project mr-1.5"></i> Alignment Tugas & Proyek PBL
            </button>
            <button onclick="switchTab('asesmen')" id="tab-asesmen" class="tab-btn py-3 border-b-2 border-transparent hover:text-indigo-600 whitespace-nowrap">
                <i class="fa-solid fa-chart-pie mr-1.5"></i> Skema Penilaian & Beban Belajar
            </button>
        </div>
    </div>
</header>

<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-1 w-full">

    <!-- SECTION 1: RINGKASAN & CPMK -->
    <section id="sec-ringkasan" class="space-y-8">
        <!-- Banner Intro -->
        <div class="bg-gradient-to-r from-indigo-900 via-indigo-800 to-slate-900 rounded-2xl p-6 sm:p-8 text-white shadow-xl relative overflow-hidden">
            <div class="max-w-3xl relative z-10 space-y-3">
                <span class="px-3 py-1 rounded-full text-xs font-semibold bg-indigo-500/30 text-indigo-200 border border-indigo-400/30">
                    Kurikulum Berbasis OBE & Project-Based Learning (PBL)
                </span>
                <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">RPS Pengolahan Citra Digital</h2>
                <p class="text-xs sm:text-sm text-indigo-100 leading-relaxed">
                    Mata kuliah ini membekali mahasiswa dengan kemampuan memahami, menganalisis, dan mengimplementasikan teknik pengolahan citra digital mulai dari representasi matriks piksel, preprocessing, ekstraksi fitur (warna, bentuk, tekstur), hingga klasifikasi citra cerdas berbasis Machine Learning (KNN/SVM) untuk menyelesaikan permasalahan di dunia nyata.
                </p>
                <div class="pt-2 flex flex-wrap gap-4 text-xs font-medium text-indigo-200">
                    <div class="flex items-center gap-1.5"><i class="fa-regular fa-user text-indigo-400"></i> Pengampu: Karunia Suci Lestari, M.Kom</div>
                    <div class="flex items-center gap-1.5"><i class="fa-solid fa-graduation-cap text-indigo-400"></i> Rumpun: Informatika / Computer Science</div>
                    <div class="flex items-center gap-1.5"><i class="fa-solid fa-code text-indigo-400"></i> Tech Stack: Python, OpenCV, NumPy, Matplotlib, Scikit-Learn</div>
                </div>
            </div>
        </div>

        <!-- Meta Info Cards Grid -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                <div class="text-xs font-semibold text-slate-500 mb-1">Bobot SKS</div>
                <div class="text-xl font-bold text-slate-900">3 SKS</div>
                <div class="text-[11px] text-indigo-600 mt-1">1 SKS Teori + 2 SKS Praktikum</div>
            </div>
            <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                <div class="text-xs font-semibold text-slate-500 mb-1">Prasyarat</div>
                <div class="text-xl font-bold text-slate-900">Pemrograman</div>
                <div class="text-[11px] text-slate-500 mt-1">Python Dasar & Aljabar Matriks</div>
            </div>
            <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                <div class="text-xs font-semibold text-slate-500 mb-1">Metode Utama</div>
                <div class="text-xl font-bold text-slate-900">PBL & Lab</div>
                <div class="text-[11px] text-emerald-600 mt-1">Studi Kasus & Live Defense</div>
            </div>
            <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                <div class="text-xs font-semibold text-slate-500 mb-1">Total Pertemuan</div>
                <div class="text-xl font-bold text-slate-900">16 Minggu</div>
                <div class="text-[11px] text-slate-500 mt-1">14 Kuliah + UTS (P8) + UAS (P16)</div>
            </div>
        </div>

        <!-- CPMK Matrix -->
        <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm space-y-4">
            <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <i class="fa-solid fa-bullseye text-indigo-600"></i>
                Capaian Pembelajaran Mata Kuliah (CPMK)
            </h3>
            <p class="text-xs text-slate-600">
                Berikut adalah 5 indikator utama capaian pembelajaran yang harus dikuasai oleh mahasiswa pada akhir semester:
            </p>
            <div class="grid md:grid-cols-2 gap-4 pt-2">
                <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-1.5">
                    <div class="flex items-center justify-between">
                        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-indigo-100 text-indigo-700">CPMK 1</span>
                        <span class="text-[10px] text-slate-400">Taksonomi Bloom: C2 (Pemahaman)</span>
                    </div>
                    <h4 class="text-xs font-bold text-slate-800">Konsep Visual Computing & Matriks Piksel</h4>
                    <p class="text-xs text-slate-600 leading-relaxed">
                        Memahami prinsip dasar citra digital, spektrum visual computing, matriks intensitas 2D, serta ruang warna (RGB, Grayscale, HSV).
                    </p>
                </div>
                <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-1.5">
                    <div class="flex items-center justify-between">
                        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-sky-100 text-sky-700">CPMK 2</span>
                        <span class="text-[10px] text-slate-400">Taksonomi Bloom: C3 (Penerapan)</span>
                    </div>
                    <h4 class="text-xs font-bold text-slate-800">Preprocessing & Perbaikan Kualitas Citra</h4>
                    <p class="text-xs text-slate-600 leading-relaxed">
                        Menguasai teknik kontras (Histogram Equalization), spatial filtering (smoothing/sharpening), dan deteksi tepi (Canny/Sobel).
                    </p>
                </div>
                <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-1.5">
                    <div class="flex items-center justify-between">
                        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-700">CPMK 3</span>
                        <span class="text-[10px] text-slate-400">Taksonomi Bloom: C4 (Analisis)</span>
                    </div>
                    <h4 class="text-xs font-bold text-slate-800">Segmentasi Citra & Ekstraksi Fitur</h4>
                    <p class="text-xs text-slate-600 leading-relaxed">
                        Menerapkan thresholding Otsu, operasi morfologi, serta ekstraksi fitur warna (HSV), bentuk (contours), dan tekstur (GLCM).
                    </p>
                </div>
                <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-1.5">
                    <div class="flex items-center justify-between">
                        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-800">CPMK 4</span>
                        <span class="text-[10px] text-slate-400">Taksonomi Bloom: C5 (Evaluasi)</span>
                    </div>
                    <h4 class="text-xs font-bold text-slate-800">Klasifikasi Machine Learning & Evaluasi</h4>
                    <p class="text-xs text-slate-600 leading-relaxed">
                        Membangun model klasifikasi citra dengan KNN & SVM, mengevaluasi perfomansi menggunakan Confusion Matrix (Accuracy, Precision, Recall).
                    </p>
                </div>
                <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-1.5 md:col-span-2">
                    <div class="flex items-center justify-between">
                        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-purple-100 text-purple-700">CPMK 5</span>
                        <span class="text-[10px] text-slate-400">Taksonomi Bloom: A3 & A4 (Sikap & Kerjasama)</span>
                    </div>
                    <h4 class="text-xs font-bold text-slate-800">Pengembangan Proyek Kelompok & Komunikasi Ilmiah</h4>
                    <p class="text-xs text-slate-600 leading-relaxed">
                        Bekerja sama dalam tim untuk menyelesaikan permasalahan riil pengolahan citra, mendokumentasikan kode dalam repositori, serta menyusun laporan makalah ilmiah dan mempresentasikannya pada sesi Live Defense.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- SECTION 2: MATRIKS PERTEMUAN (P1 - P16) -->
    <section id="sec-matriks" class="space-y-6 hidden">
        <!-- Controls & Filters Bar -->
        <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm space-y-3">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
                <div>
                    <h3 class="text-base font-bold text-slate-900">Matriks Perancangan Pembelajaran 16 Minggu</h3>
                    <p class="text-xs text-slate-500">Gunakan filter atau pencarian untuk menjelajahi detail materi dan praktikum mingguan.</p>
                </div>
                <!-- Search Box -->
                <div class="relative w-full md:w-72">
                    <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-xs text-slate-400"></i>
                    <input type="text" id="search-input" onkeyup="filterWeeks()" placeholder="Cari materi, topik, atau fungsi..." class="w-full pl-9 pr-3 py-1.5 text-xs rounded-lg border border-slate-200 focus:outline-none focus:border-indigo-500 bg-slate-50">
                </div>
            </div>
            <!-- Phase Filter Badges -->
            <div class="flex flex-wrap items-center gap-2 pt-2 border-t border-slate-100 text-xs">
                <span class="text-slate-500 font-semibold mr-1">Filter Fase:</span>
                <button onclick="setPhaseFilter('all')" class="phase-btn px-3 py-1 rounded-full bg-indigo-600 text-white font-medium shadow-sm" data-phase="all">Semua (P1-P16)</button>
                <button onclick="setPhaseFilter('fase1')" class="phase-btn px-3 py-1 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium" data-phase="fase1">Fase 1: Acquisition & Preprocessing (P1-P3)</button>
                <button onclick="setPhaseFilter('fase2')" class="phase-btn px-3 py-1 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium" data-phase="fase2">Fase 2: Segmentation & Feature (P4-P7)</button>
                <button onclick="setPhaseFilter('uts')" class="phase-btn px-3 py-1 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium" data-phase="uts">P8: UTS / Defense 1</button>
                <button onclick="setPhaseFilter('fase3')" class="phase-btn px-3 py-1 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium" data-phase="fase3">Fase 3: ML & Evaluation (P9-P13)</button>
                <button onclick="setPhaseFilter('fase4')" class="phase-btn px-3 py-1 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium" data-phase="fase4">Fase 4: Integration & Defense (P14-P16)</button>
            </div>
        </div>

        <!-- Weekly Cards List -->
        <div id="weeks-container" class="space-y-4">
            <!-- Dynamic Injection by JS -->
        </div>
    </section>

    <!-- SECTION 3: ALIGNMENT TUGAS & PROYEK PBL -->
    <section id="sec-pbl-map" class="space-y-6 hidden">
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4">
            <h3 class="text-lg font-bold text-slate-900 flex items-center gap-2">
                <i class="fa-solid fa-diagram-project text-indigo-600"></i>
                Peta Alur Proyek Kelompok (Project-Based Learning Flow)
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed">
                Jawaban atas pertanyaan: <strong>"Apakah tugas disesuaikan dengan RPS?"</strong> Ya, skema Project-Based Learning pada mata kuliah ini dirancang dengan prinsip <em>Constructive Alignment</em>. Setiap milestone tugas mingguan merupakan eksekusi langsung dari pokok bahasan RPS di minggu tersebut, sehingga mahasiswa tidak terbeban tugas terpisah di luar capaian RPS.
            </p>

            <div class="grid md:grid-cols-3 gap-6 pt-4">
                <!-- Phase 1 -->
                <div class="bg-indigo-50/50 border border-indigo-200 rounded-xl p-5 space-y-3">
                    <div class="flex items-center justify-between">
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-indigo-600 text-white">MILESTONE 1 (P1-P3)</span>
                        <span class="text-[10px] font-semibold text-indigo-700">Tugas Awal</span>
                    </div>
                    <h4 class="text-sm font-bold text-indigo-950">Data Acquisition & Preprocessing Pipeline</h4>
                    <p class="text-xs text-slate-600 leading-relaxed">
                        Mahasiswa membentuk kelompok (3-4 orang), memilih domain (medis, pertanian, biometrik, otomotif), mengumpulkan 50-100 citra per kelas, dan membangun script konversi warna BGR-RGB-HSV serta noise filtering.
                    </p>
                    <div class="pt-2 border-t border-indigo-200/60 text-[11px] text-indigo-800">
                        <strong>Output Deliverable:</strong> Google Colab Notebook (Dataset Raw & Cleaned)
                    </div>
                </div>

                <!-- Phase 2 -->
                <div class="bg-sky-50/50 border border-sky-200 rounded-xl p-5 space-y-3">
                    <div class="flex items-center justify-between">
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-sky-600 text-white">MILESTONE 2 (P4-P7)</span>
                        <span class="text-[10px] font-semibold text-sky-700">Tugas Tengah</span>
                    </div>
                    <h4 class="text-sm font-bold text-sky-950">Segmentation & Multi-Feature Matrix Extraction</h4>
                    <p class="text-xs text-slate-600 leading-relaxed">
                        Mengaplikasikan thresholding Otsu/HSV, mengekstrak fitur Warna (mean/std HSV), Bentuk (area/perimeter), dan Tekstur (GLCM), kemudian menyimpannya ke format CSV/Dataframe.
                    </p>
                    <div class="pt-2 border-t border-sky-200/60 text-[11px] text-sky-800">
                        <strong>Output Deliverable:</strong> Feature Dataset CSV & Mid-Term Presentation (P8 UTS)
                    </div>
                </div>

                <!-- Phase 3 -->
                <div class="bg-emerald-50/50 border border-emerald-200 rounded-xl p-5 space-y-3">
                    <div class="flex items-center justify-between">
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-emerald-600 text-white">MILESTONE 3 (P9-P16)</span>
                        <span class="text-[10px] font-semibold text-emerald-700">Tugas Akhir</span>
                    </div>
                    <h4 class="text-sm font-bold text-emerald-950">Machine Learning Model & Final Live Defense</h4>
                    <p class="text-xs text-slate-600 leading-relaxed">
                        Melatih model KNN & SVM, melakukan tuning hyperparameter, mengukur performa dengan Confusion Matrix, menyusun laporan paper IEEE 4 halaman, dan mengikuti ujian lisan kelompok.
                    </p>
                    <div class="pt-2 border-t border-emerald-200/60 text-[11px] text-emerald-800">
                        <strong>Output Deliverable:</strong> Paper Laporan Akhir, App Demo & Live Defense (P16 UAS)
                    </div>
                </div>
            </div>

            <!-- Mapping Table -->
            <div class="pt-4 overflow-x-auto">
                <table class="w-full text-left text-xs border-collapse border border-slate-200">
                    <thead>
                        <tr class="bg-slate-100 text-slate-700 font-bold border-b border-slate-200">
                            <th class="p-3 border-r border-slate-200">Minggu</th>
                            <th class="p-3 border-r border-slate-200">Materi Pokok RPS</th>
                            <th class="p-3 border-r border-slate-200">Praktikum Colab / Lab</th>
                            <th class="p-3">Tugas Kelompok Proyek (Milestone Alignment)</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200 text-slate-600">
                        <tr>
                            <td class="p-3 font-semibold text-indigo-600 border-r border-slate-200">P1</td>
                            <td class="p-3 border-r border-slate-200">Konsep PCD, Piksel & Matriks Warna</td>
                            <td class="p-3 border-r border-slate-200">Setup Colab, cv2.imread, BGR to RGB</td>
                            <td class="p-3 font-medium text-slate-800">Pembentukan Kelompok & Penentuan Judul Proyek</td>
                        </tr>
                        <tr>
                            <td class="p-3 font-semibold text-indigo-600 border-r border-slate-200">P2</td>
                            <td class="p-3 border-r border-slate-200">Brightness, Contrast & Histogram Equalization</td>
                            <td class="p-3 border-r border-slate-200">cv2.calcHist, cv2.equalizeHist</td>
                            <td class="p-3 font-medium text-slate-800">Pengumpulan Dataset Citra Awal (50-100 sampel/kelas)</td>
                        </tr>
                        <tr>
                            <td class="p-3 font-semibold text-indigo-600 border-r border-slate-200">P3</td>
                            <td class="p-3 border-r border-slate-200">Spatial Filtering & Edge Detection</td>
                            <td class="p-3 border-r border-slate-200">cv2.GaussianBlur, cv2.Canny</td>
                            <td class="p-3 font-medium text-slate-800">Pembersihan Noise & Standarisasi Ukuran Citra Dataset</td>
                        </tr>
                        <tr>
                            <td class="p-3 font-semibold text-indigo-600 border-r border-slate-200">P4</td>
                            <td class="p-3 border-r border-slate-200">Segmentasi Citra & Otsu Thresholding</td>
                            <td class="p-3 border-r border-slate-200">cv2.threshold, cv2.inRange (HSV)</td>
                            <td class="p-3 font-medium text-slate-800">Pembuatan Masking Segmentasi Objek Proyek</td>
                        </tr>
                        <tr>
                            <td class="p-3 font-semibold text-indigo-600 border-r border-slate-200">P5</td>
                            <td class="p-3 border-r border-slate-200">Operasi Morfologi & Kontur Objek</td>
                            <td class="p-3 border-r border-slate-200">cv2.morphologyEx, cv2.findContours</td>
                            <td class="p-3 font-medium text-slate-800">Eksplorasi Bounding Box Objek Target Proyek</td>
                        </tr>
                        <tr>
                            <td class="p-3 font-semibold text-indigo-600 border-r border-slate-200">P6</td>
                            <td class="p-3 border-r border-slate-200">Ekstraksi Fitur Warna & Bentuk</td>
                            <td class="p-3 border-r border-slate-200">Statistik HSV, Area, Perimeter, Aspect Ratio</td>
                            <td class="p-3 font-medium text-slate-800">Ekstraksi Fitur Warna & Bentuk ke DataFrame Pandas</td>
                        </tr>
                        <tr>
                            <td class="p-3 font-semibold text-indigo-600 border-r border-slate-200">P7</td>
                            <td class="p-3 border-r border-slate-200">Ekstraksi Fitur Tekstur (GLCM)</td>
                            <td class="p-3 border-r border-slate-200">skimage.feature.graycomatrix</td>
                            <td class="p-3 font-medium text-slate-800">Finalisasi Dataset Fitur Lengkap (CSV Export)</td>
                        </tr>
                        <tr class="bg-amber-50">
                            <td class="p-3 font-semibold text-amber-700 border-r border-slate-200">P8</td>
                            <td class="p-3 font-semibold text-amber-900 border-r border-slate-200" colspan="2">Ujian Tengah Semester (UTS) / Progress Defense 1</td>
                            <td class="p-3 font-bold text-amber-900">Presentasi Milestone 1-2 & Demo Code Pipeline</td>
                        </tr>
                        <tr>
