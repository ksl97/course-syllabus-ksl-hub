    }

    // Grade Simulator Calculation
    function calculateGrade() {
        const p = parseFloat(document.getElementById('score-presensi').value) || 0;
        const t = parseFloat(document.getElementById('score-tugas').value) || 0;
        const uts = parseFloat(document.getElementById('score-uts').value) || 0;
        const uas = parseFloat(document.getElementById('score-uas').value) || 0;

        const total = (p * 0.10) + (t * 0.20) + (uts * 0.30) + (uas * 0.40);
        document.getElementById('score-total').textContent = `${total.toFixed(2)} / 100.00`;

        const gradeBadge = document.getElementById('grade-badge');
        const statusLulus = document.getElementById('status-lulus');

        if (total >= 85) {
            gradeBadge.textContent = "A (4.00)";
            gradeBadge.className = "px-4 py-1.5 rounded-full text-base font-extrabold bg-emerald-100 text-emerald-800";
            statusLulus.innerHTML = `<i class="fa-solid fa-circle-check"></i> LULUS SANGAT MEMUASKAN`;
            statusLulus.className = "text-sm font-bold text-emerald-600 flex items-center gap-1.5";
        } else if (total >= 75) {
            gradeBadge.textContent = "B+ (3.50)";
            gradeBadge.className = "px-4 py-1.5 rounded-full text-base font-extrabold bg-indigo-100 text-indigo-800";
            statusLulus.innerHTML = `<i class="fa-solid fa-circle-check"></i> LULUS MEMUASKAN`;
            statusLulus.className = "text-sm font-bold text-indigo-600 flex items-center gap-1.5";
        } else if (total >= 70) {
            gradeBadge.textContent = "B (3.00)";
            gradeBadge.className = "px-4 py-1.5 rounded-full text-base font-extrabold bg-sky-100 text-sky-800";
            statusLulus.innerHTML = `<i class="fa-solid fa-circle-check"></i> LULUS BAIK`;
            statusLulus.className = "text-sm font-bold text-sky-600 flex items-center gap-1.5";
        } else if (total >= 60) {
            gradeBadge.textContent = "C+ (2.50)";
            gradeBadge.className = "px-4 py-1.5 rounded-full text-base font-extrabold bg-amber-100 text-amber-800";
            statusLulus.innerHTML = `<i class="fa-solid fa-triangle-exclamation"></i> LULUS CUKUP`;
            statusLulus.className = "text-sm font-bold text-amber-600 flex items-center gap-1.5";
        } else {
            gradeBadge.textContent = "D / E (< 60)";
            gradeBadge.className = "px-4 py-1.5 rounded-full text-base font-extrabold bg-rose-100 text-rose-800";
            statusLulus.innerHTML = `<i class="fa-solid fa-circle-xmark"></i> TIDAK LULUS / REMEDIAL`;
            statusLulus.className = "text-sm font-bold text-rose-600 flex items-center gap-1.5";
        }
    }

    // Chart.js Setup
    function initCharts() {
        // Donut Chart: Grading Breakdown
        const ctxGrading = document.getElementById('chart-grading').getContext('2d');
        new Chart(ctxGrading, {
            type: 'doughnut',
            data: {
                labels: ['Presensi (10%)', 'Tugas & Lab (20%)', 'UTS / Milestone 1 (30%)', 'UAS / Defense Project (40%)'],
                datasets: [{
                    data: [10, 20, 30, 40],
                    backgroundColor: ['#6366f1', '#0EA5E9', '#F59E0B', '#10B981'],
                    borderWidth: 2,
                    borderColor: '#ffffff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { boxWidth: 12, font: { size: 10 } }
                    }
                }
            }
        });

        // Bar Chart: Workload per Week
        const ctxWorkload = document.getElementById('chart-workload').getContext('2d');
        new Chart(ctxWorkload, {
            type: 'bar',
            data: {
                labels: ['P1', 'P2', 'P3', 'P4', 'P5', 'P6', 'P7', 'UTS', 'P9', 'P10', 'P11', 'P12', 'P13', 'P14', 'P15', 'UAS'],
                datasets: [{
                    label: 'Estimasi Jam Beban/Minggu',
                    data: [8, 8, 8, 9, 9, 9, 10, 12, 8, 9, 9, 9, 8, 10, 10, 12],
                    backgroundColor: '#4f46e5',
                    borderRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: { beginAtZero: true, ticks: { font: { size: 10 } } },
                    x: { ticks: { font: { size: 10 } } }
                },
                plugins: {
                    legend: { display: false }
                }
            }
        });
    }

    // Modal Export Text Setup
    function openExportModal() {
        let text = "RENCANA PEMBELAJARAN SEMESTER (RPS)\nMATA KULIAH: PENGOLAHAN CITRA DIGITAL (3 SKS)\n======================================================\n\n";
        text += "1. CAPAIAN PEMBELAJARAN (CPMK):\n";
        text += "• CPMK 1: Memahami konsep visual computing & matriks piksel.\n";
        text += "• CPMK 2: Menguasai preprocessing citra (kontras, histogram, filtering, Canny).\n";
        text += "• CPMK 3: Menerapkan segmentasi Otsu & ekstraksi fitur (warna, bentuk, GLCM).\n";
        text += "• CPMK 4: Membangun model klasifikasi ML (KNN, SVM) & evaluasi confusion matrix.\n";
        text += "• CPMK 5: Menyusun paper laporan ilmiah IEEE & melakukan live defense proyek.\n\n";
        text += "2. MATRIKS PERTEMUAN MINGGUAN (P1 - P16):\n\n";

        rpsWeeksData.forEach(w => {
            text += `[P${w.week}] ${w.title} (${w.cpmk})\n`;
            text += `   - Teori: ${w.subtopics}\n`;
            text += `   - Lab: ${w.lab}\n`;
            text += `   - Proyek: ${w.projectTask}\n\n`;
        });

        document.getElementById('export-textarea').value = text;
        document.getElementById('export-modal').classList.remove('hidden');
    }

    function closeExportModal() {
        document.getElementById('export-modal').classList.add('hidden');
    }

    function copyToClipboard() {
        const textarea = document.getElementById('export-textarea');
        textarea.select();
        document.execCommand('copy');
        
        const status = document.getElementById('copy-status');
        status.classList.remove('opacity-0');
        setTimeout(() => {
            status.classList.add('opacity-0');
        }, 2000);
    }

    // Init
    window.addEventListener('DOMContentLoaded', () => {
        renderWeeks();
        initCharts();
        calculateGrade();
    });
</script>
</body>
</html>
